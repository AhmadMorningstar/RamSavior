<ui:FluentWindow x:Class="RamSavior.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="RAM Savior"
        Width="440"
        MinHeight="360" MinWidth="380"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="RAM Savior" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RootContent" Margin="24,12,24,24" VerticalAlignment="Top">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Memory Status" FontSize="14" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="1" x:Name="SettingsButton"
                           Icon="{ui:SymbolIcon Symbol=Settings24}"
                           Appearance="Secondary"
                           Width="32" Height="32" Padding="0"
                           Click="SettingsButton_Click"/>
            </Grid>

            <ui:CardExpander IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <TextBlock x:Name="AvailableText" Text="-- GB available" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalText" Text="of -- GB total" Opacity="0.6" Margin="0,0,0,12"/>
                    <ui:ProgressRing x:Name="LoadRing" Progress="0" IsIndeterminate="False" Width="0" Height="0"/>
                    <ProgressBar x:Name="LoadBar" Minimum="0" Maximum="100" Value="0" Height="8"/>
                    <TextBlock x:Name="LoadPercentText" Text="0% memory load" Margin="0,4,0,0" Opacity="0.6"/>
                </StackPanel>
            </ui:CardExpander>

            <TextBlock Text="Clean Mode" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Options24}">
                <StackPanel>
                    <RadioButton x:Name="SmartModeRadio" Content="Smart Clean (recommended)" IsChecked="True" GroupName="Mode" Checked="ModeRadio_Checked"/>
                    <TextBlock Text="Targets low-reuse cache only. Minimal disk-reload risk." Opacity="0.6" FontSize="11" Margin="20,2,0,6"/>
                    <RadioButton x:Name="FullModeRadio" Content="Full Purge" GroupName="Mode" Checked="ModeRadio_Checked"/>
                    <TextBlock Text="Flushes all standby cache, including hot pages. May cause brief disk activity as apps reload data." Opacity="0.6" FontSize="11" Margin="20,2,0,6" TextWrapping="Wrap"/>
                    <RadioButton x:Name="CustomModeRadio" Content="Custom" GroupName="Mode" Checked="ModeRadio_Checked"/>
                    <TextBlock Text="Pick exactly which cleanup actions to run." Opacity="0.6" FontSize="11" Margin="20,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ui:CardControl>

            <ui:CardExpander x:Name="CustomPanel" IsExpanded="True" Visibility="Collapsed" Margin="0,0,0,8">
                <StackPanel x:Name="CustomItemsPanel" Margin="4"/>
            </ui:CardExpander>

            <ui:Button x:Name="CleanButton"
                       Content="Purge Memory Now"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Broom24}"
                       Height="44"
                       FontWeight="SemiBold"
                       Margin="0,16,0,0"
                       Click="CleanButton_Click"/>

            <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8"/>

            <StackPanel x:Name="ExperimentalSection" Visibility="Collapsed" Margin="0,20,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Experimental" FontSize="14" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#E5484D" CornerRadius="4" Padding="6,1,6,1">
                        <TextBlock Text="EXPERIMENTAL" FontSize="9" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </Grid>

                <ui:CardExpander IsExpanded="True">
                    <StackPanel Margin="4">
                        <TextBlock Text="Trim a specific process" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Text="Uses the official Windows EmptyWorkingSet API on one chosen app instead of purging system-wide." Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="ProcessComboBox" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" x:Name="RefreshProcessesButton"
                                       Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                       Appearance="Secondary" Width="36" Height="36" Padding="0"
                                       Click="RefreshProcessesButton_Click"/>
                        </Grid>

                        <ui:Button x:Name="TrimProcessButton"
                                   Content="Trim Selected Process"
                                   Appearance="Secondary"
                                   Height="36"
                                   Margin="0,10,0,0"
                                   Click="TrimProcessButton_Click"/>

                        <TextBlock x:Name="ExperimentalResultText" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
