<ui:FluentWindow x:Class="RamSavior.App.AutomationConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Icon="Assets/Icons/app.ico"
        Title="Automation Configuration"
        Width="640" Height="820"
        MinWidth="520" MinHeight="480"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Automation Configuration" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">

            <TextBlock Text="Everything about background automation lives here — when it fires and exactly what it does." FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="AutomationEnabledCheckBox" Content="Enable automatic cleaning"
                              ToolTip="Turns background automation on or off. Cleans according to the trigger conditions and item selection below."
                              Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Runs in the background even when the window is closed (look for the tray icon)."/>
                </StackPanel>
            </Border>

            <TextBlock Text="What automation cleans" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <RadioButton x:Name="AutoTierNormalRadio" Content="Normal (recommended)" GroupName="AutoTier"
                                 ToolTip="Targets low-reuse standby cache only. Minimal disk-reload risk. Safe default for unattended runs."
                                 Checked="AutomationTierRadio_Checked"/>
                    <RadioButton x:Name="AutoTierModerateRadio" Content="Moderate" GroupName="AutoTier" Margin="0,6,0,0"
                                 ToolTip="Also flushes working sets for a bit more freed memory. Still low risk."
                                 Checked="AutomationTierRadio_Checked"/>
                    <RadioButton x:Name="AutoTierCustomRadio" Content="Custom — pick exactly" GroupName="AutoTier" Margin="0,6,0,0"
                                 ToolTip="Choose exactly which cleanup actions run unattended, including options that may briefly affect responsiveness."
                                 Checked="AutomationTierRadio_Checked"/>
                    <TextBlock x:Name="AutoTierCustomLockedText" Margin="20,4,0,0" FontSize="10" Opacity="0.8" TextWrapping="Wrap"
                               Foreground="#E5A21A" Visibility="Collapsed"
                               Text="Switch the main window's Mode to Advanced or Experimental to unlock Custom automation items."/>

                    <Border x:Name="AutoCustomPanel" Background="#0DFFFFFF" CornerRadius="6" Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="AutoCustomItemsPanel"/>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Trigger conditions (any enabled condition can fire a clean)" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="IntervalEnabledCheckBox" Content="Every" ToolTip="Clean on a fixed timer, regardless of memory pressure." Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                            <Grid Margin="20,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="IntervalMinutesBox" LostFocus="AutomationSetting_Changed"/>
                                <TextBlock Grid.Column="1" Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                            </Grid>

                            <CheckBox x:Name="FreeMemThresholdCheckBox" Content="Free memory drops below" ToolTip="Clean as soon as available RAM falls under this amount." Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                            <Grid Margin="20,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="FreeMemGbBox" LostFocus="AutomationSetting_Changed"/>
                                <TextBlock Grid.Column="1" Text="GB" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                            </Grid>

                            <CheckBox x:Name="LoadPercentThresholdCheckBox" Content="Memory load exceeds" ToolTip="Clean once overall memory usage crosses this percentage." Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                            <Grid Margin="20,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="LoadPercentBox" LostFocus="AutomationSetting_Changed"/>
                                <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <CheckBox x:Name="StandbyThresholdCheckBox" Content="Standby cache exceeds" ToolTip="Only clean once there's meaningful reclaimable cache built up — avoids pointless purges." Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                            <TextBlock Margin="20,2,0,4" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                                       Text="The ISLC-style condition: purges only when there's meaningful reclaimable cache."/>
                            <Grid Margin="20,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="StandbyMbBox" LostFocus="AutomationSetting_Changed"/>
                                <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                            </Grid>

                            <CheckBox x:Name="TimeOfDayCheckBox" Content="Also clean once daily at" ToolTip="Runs one extra guaranteed clean at this time every day." Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                            <Grid Margin="20,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TimeOfDayBox" LostFocus="AutomationSetting_Changed"/>
                                <TextBlock Grid.Column="1" Text="24h, e.g. 03:00" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="PerProcessAutoTrimCheckBox" Content="Auto-trim any process using more than" ToolTip="Trims any single app's working set once it crosses this size, independent of the system-wide conditions above." Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                            <TextBlock Margin="20,2,0,4" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                                       Text="Checked every 30 seconds, independent of the conditions above."/>
                            <Grid Margin="20,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="PerProcessMbBox" LostFocus="AutomationSetting_Changed"/>
                                <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Only clean when idle for" FontSize="11" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="IdleMinutesBox" ToolTip="Only clean once you've been away from the keyboard/mouse this long. 0 disables the idle requirement." LostFocus="AutomationSetting_Changed"/>
                                <TextBlock Grid.Column="1" Text="min (0 = off)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10,0,10"/>

                    <TextBlock Text="Pause automation while these apps are running (comma-separated process names, no .exe)" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox x:Name="ExcludedProcessesBox" ToolTip="Automation is fully paused while any app in this list is running — e.g. games, video editors, anything sensitive to a brief stutter." LostFocus="AutomationSetting_Changed"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Margin="0,4,0,0" Opacity="0.6" FontSize="11"/>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
