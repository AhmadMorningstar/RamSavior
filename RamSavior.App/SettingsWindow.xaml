<ui:FluentWindow x:Class="RamSavior.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings"
        Width="1040" Height="740"
        MinHeight="480" MinWidth="820"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Settings" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Appearance, Layout, Startup & Shortcuts, Danger Zone -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <RadioButton x:Name="SystemThemeRadio" Content="Follow system" GroupName="Theme" Checked="ThemeRadio_Checked"/>
                            <RadioButton x:Name="LightThemeRadio" Content="Light" GroupName="Theme" Margin="0,6,0,0" Checked="ThemeRadio_Checked"/>
                            <RadioButton x:Name="DarkThemeRadio" Content="Dark" GroupName="Theme" Margin="0,6,0,0" Checked="ThemeRadio_Checked"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Accent Color" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="AccentSwatches" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="Layout" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="CompactModeCheckBox" Content="Compact Mode" Checked="CompactModeCheckBox_Changed" Unchecked="CompactModeCheckBox_Changed"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Shrinks spacing and text throughout the app. Good fit for smaller or lower-resolution screens."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Startup &amp; Shortcuts" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start RAM Savior when Windows starts" Checked="StartupSetting_Changed" Unchecked="StartupSetting_Changed"/>
                            <TextBlock Margin="0,4,0,10" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Uses a Scheduled Task (not a registry entry) so elevation works correctly, since this app requires admin."/>

                            <CheckBox x:Name="GlobalHotkeyCheckBox" Content="Enable global hotkey: Ctrl+Alt+R" Checked="StartupSetting_Changed" Unchecked="StartupSetting_Changed"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Triggers a Normal/Moderate clean (whichever is selected) from anywhere, even while gaming. Not customizable yet — fixed combination for now."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Danger Zone" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                    <Border BorderBrush="#E5484D" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Reset RAM Savior" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Turns off automation, removes the startup task and global hotkey, and deletes all saved settings and history. The app keeps running with defaults — this doesn't uninstall anything."/>
                            <ui:Button Content="Reset Everything" Appearance="Danger" Click="ResetButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT: Automation (the big one) + Advanced/Experimental note -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Automation" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="AutomationEnabledCheckBox" Content="Enable automatic cleaning" Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                            <TextBlock Margin="0,4,0,12" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Runs in the background even when the window is closed (look for the tray icon). Always uses Normal or Moderate — never Advanced or Experimental — so nothing risky happens unattended."/>

                            <Separator Margin="0,0,0,10"/>

                            <TextBlock Text="Trigger conditions (any enabled condition can fire a clean)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="IntervalEnabledCheckBox" Content="Every" Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                                    <Grid Margin="20,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="IntervalMinutesBox" LostFocus="AutomationSetting_Changed"/>
                                        <TextBlock Grid.Column="1" Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                                    </Grid>

                                    <CheckBox x:Name="FreeMemThresholdCheckBox" Content="Free memory drops below" Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                                    <Grid Margin="20,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="FreeMemGbBox" LostFocus="AutomationSetting_Changed"/>
                                        <TextBlock Grid.Column="1" Text="GB" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                                    </Grid>

                                    <CheckBox x:Name="LoadPercentThresholdCheckBox" Content="Memory load exceeds" Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                                    <Grid Margin="20,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="LoadPercentBox" LostFocus="AutomationSetting_Changed"/>
                                        <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CheckBox x:Name="StandbyThresholdCheckBox" Content="Standby cache exceeds" Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                                    <TextBlock Margin="20,2,0,4" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                                               Text="The ISLC-style condition: purges only when there's meaningful reclaimable cache."/>
                                    <Grid Margin="20,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="StandbyMbBox" LostFocus="AutomationSetting_Changed"/>
                                        <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                                    </Grid>

                                    <CheckBox x:Name="TimeOfDayCheckBox" Content="Also clean once daily at" Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                                    <Grid Margin="20,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TimeOfDayBox" LostFocus="AutomationSetting_Changed"/>
                                        <TextBlock Grid.Column="1" Text="24h, e.g. 03:00" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,10,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="PerProcessAutoTrimCheckBox" Content="Auto-trim any process using more than" Checked="AutomationSetting_Changed" Unchecked="AutomationSetting_Changed"/>
                                    <TextBlock Margin="20,2,0,4" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                                               Text="Checked every 30 seconds, independent of the conditions above."/>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="PerProcessMbBox" LostFocus="AutomationSetting_Changed"/>
                                        <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Only clean when idle for" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="IdleMinutesBox" LostFocus="AutomationSetting_Changed"/>
                                        <TextBlock Grid.Column="1" Text="min (0 = off)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,10,0,10"/>

                            <TextBlock Text="Pause automation while these apps are running (comma-separated process names, no .exe)" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBox x:Name="ExcludedProcessesBox" LostFocus="AutomationSetting_Changed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Advanced &amp; Experimental" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Controlled from the main window now" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                                       Text="Use the Mode dropdown at the top of the main window to switch between Normal, Advanced, and Experimental — it reveals the checkbox picker, Focus Mode, and per-process tools directly, instead of a separate toggle here."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" Margin="0,16,0,0" Opacity="0.6" FontSize="11"/>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
