<ui:FluentWindow x:Class="RamSavior.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Icon="Assets/Icons/app.ico"
        Title="Settings"
        Width="640" Height="760"
        MinHeight="440" MinWidth="480"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Settings" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">

            <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <RadioButton x:Name="SystemThemeRadio" Content="Follow system" GroupName="Theme" ToolTip="Matches whatever Windows itself is set to, light or dark." Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="LightThemeRadio" Content="Light" GroupName="Theme" Margin="0,6,0,0" ToolTip="Always use the light appearance, regardless of Windows settings." Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="DarkThemeRadio" Content="Dark" GroupName="Theme" Margin="0,6,0,0" ToolTip="Always use the dark appearance, regardless of Windows settings." Checked="ThemeRadio_Checked"/>
                    <TextBlock Margin="0,4,0,0" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                               Text="The sun/moon icon at the top of the main window is a quicker Light/Dark shortcut for day-to-day use."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Accent Color" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <ItemsControl x:Name="AccentSwatches" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="Layout" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="CompactModeCheckBox" Content="Compact Mode" ToolTip="Scales the whole app down — handy on small or low-resolution screens." Checked="CompactModeCheckBox_Changed" Unchecked="CompactModeCheckBox_Changed"/>
                    <TextBlock Margin="0,4,0,10" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Shrinks spacing and text throughout the app. Good fit for smaller or lower-resolution screens."/>
                    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Which sections appear on the main window, and (in Experimental mode) their drag-and-drop arrangement, are handled by the Layout icon on the main window itself, not here."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Startup &amp; Shortcuts" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start RAM Savior when Windows starts" ToolTip="Launches RAM Savior automatically at sign-in via a Scheduled Task." Checked="StartupSetting_Changed" Unchecked="StartupSetting_Changed"/>
                    <TextBlock Margin="0,4,0,10" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Uses a Scheduled Task (not a registry entry) so elevation works correctly, since this app requires admin."/>

                    <CheckBox x:Name="GlobalHotkeyCheckBox" Content="Enable global hotkey: Ctrl+Alt+R" ToolTip="Runs a quick clean from anywhere on your PC, even in a full-screen game." Checked="StartupSetting_Changed" Unchecked="StartupSetting_Changed"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Triggers a Normal/Moderate clean (whichever is selected on the main window) from anywhere, even while gaming. Not customizable yet — fixed combination for now."/>
                </StackPanel>
            </Border>

            <TextBlock Text="About Modes" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Controlled from the main window" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                               Text="Use the Mode dropdown at the top of the main window to switch between Normal, Advanced, and Experimental — it reveals the checkbox picker, Focus Mode, per-process tools, and the custom drag-and-drop layout directly. The wrench icon opens Automation Configuration, a dedicated window for everything about background cleaning."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Danger Zone" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border BorderBrush="#E5484D" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Reset RAM Savior" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Turns off automation, removes the startup task and global hotkey, and deletes all saved settings and history. The app keeps running with defaults — this doesn't uninstall anything."/>
                    <ui:Button Content="Reset Everything" Appearance="Danger" ToolTip="Deletes all saved settings and history and turns automation off. Cannot be undone." Click="ResetButton_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Margin="0,16,0,0" Opacity="0.6" FontSize="11"/>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
