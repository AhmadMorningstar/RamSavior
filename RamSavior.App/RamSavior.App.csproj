<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RamSavior.App</RootNamespace>
    <AssemblyName>RamSavior</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Framework-dependent publish for the GUI: smaller download, one-time runtime
         prompt if missing. See PUBLISH.md for the self-contained alternative. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- lepoco/wpfui — Fluent controls + Mica/Acrylic backdrop for WPF, no Windows App
         SDK runtime dependency. Check for the latest stable version on NuGet before
         restoring; pin whatever version you land on. -->
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RamSavior.Core\RamSavior.Core.csproj" />
  </ItemGroup>

</Project>
