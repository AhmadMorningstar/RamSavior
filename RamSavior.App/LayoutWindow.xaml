<ui:FluentWindow x:Class="RamSavior.App.LayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Icon="Assets/Icons/app.ico"
        Title="Layout"
        Width="440" Height="760"
        MinWidth="380" MinHeight="480"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Layout" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">

            <TextBlock Text="Choose which sections appear on the main window. Turn off anything you don't use to free up space for what you do." FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16">
                <StackPanel>
                    <CheckBox x:Name="MemoryStatusCheckBox" Content="Memory Status" Margin="0,0,0,10"
                              ToolTip="The available/total RAM card and composition bar"
                              Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"/>
                    <CheckBox x:Name="InsightsCheckBox" Content="Insights" Margin="0,0,0,10"
                              ToolTip="Top memory users, history, and last-cleaned tabs"
                              Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"/>
                    <CheckBox x:Name="AutomationCheckBox" Content="Automation" Margin="0,0,0,10"
                              ToolTip="The quick automation toggle and Configure shortcut"
                              Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"/>
                    <CheckBox x:Name="CleanCheckBox" Content="Clean" Margin="0,0,0,10"
                              ToolTip="The manual cleanup tier picker and Purge Memory Now button"
                              Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"/>
                    <CheckBox x:Name="FocusModeCheckBox" Content="Focus Mode" Margin="0,0,0,10"
                              ToolTip="The protected-apps list and Focus Mode controls"
                              Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"/>
                    <CheckBox x:Name="PerProcessTrimCheckBox" Content="Per-Process Trim"
                              ToolTip="Trimming a single chosen process"
                              Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"/>
                </StackPanel>
            </Border>

            <ui:Button Content="Show Everything" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,16,0,16"
                       ToolTip="Turn every section back on"
                       Click="ShowEverythingButton_Click"/>

            <TextBlock Text="Arrangement" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <RadioButton x:Name="AutoArrangeRadio" Content="Automatic (recommended)" GroupName="Arrange"
                                 ToolTip="Sections reflow on their own to fill whatever space is available."
                                 Checked="ArrangeRadio_Checked"/>
                    <RadioButton x:Name="CustomArrangeRadio" Content="Custom — drag, drop, and resize" GroupName="Arrange" Margin="0,6,0,0"
                                 ToolTip="Drag any section by its title anywhere on the window, and resize it from its bottom-right corner. Edges snap to the canvas and to other sections as you drag."
                                 Checked="ArrangeRadio_Checked"/>
                    <TextBlock x:Name="ArrangeLockedText" Margin="20,4,0,0" FontSize="10" Opacity="0.8" TextWrapping="Wrap"
                               Foreground="#E5A21A" Visibility="Collapsed"
                               Text="Switch the main window's Mode to Experimental to use Custom arrangement."/>

                    <StackPanel x:Name="SavedArrangementsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <Separator Margin="0,0,0,10"/>
                        <TextBlock Text="Saved layouts" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SavedArrangementsCombo" Margin="0,0,0,8"
                                  ToolTip="Load a previously saved custom layout"
                                  SelectionChanged="SavedArrangementsCombo_SelectionChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="Save Current As..." Appearance="Secondary" FontSize="11" Margin="0,0,8,0"
                                       ToolTip="Save the current positions and sizes under a name"
                                       Click="SaveArrangementButton_Click"/>
                            <ui:Button Content="Delete" Appearance="Secondary" FontSize="11"
                                       ToolTip="Delete the selected saved layout"
                                       Click="DeleteArrangementButton_Click"/>
                        </StackPanel>

                        <Grid x:Name="SaveAsPrompt" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="SaveAsNameBox" Margin="0,0,8,0" ToolTip="Name for this layout"/>
                            <ui:Button Grid.Column="1" Content="Save" Appearance="Primary" Click="ConfirmSaveArrangementButton_Click"/>
                        </Grid>

                        <ui:Button Content="Reset Positions" Appearance="Secondary" FontSize="11" HorizontalAlignment="Left"
                                   ToolTip="Clears saved positions — sections cascade back to their default spots"
                                   Click="ResetArrangementButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Icon Bar Position" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Where the Layout/Theme/Automation/History/Settings icons sit." FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ComboBox x:Name="IconBarPositionCombo"
                              ToolTip="Move the icon bar to any corner or top/bottom center of the window"
                              SelectionChanged="IconBarPositionCombo_SelectionChanged">
                        <ComboBoxItem Content="Top Right"/>
                        <ComboBoxItem Content="Top Center"/>
                        <ComboBoxItem Content="Top Left"/>
                        <ComboBoxItem Content="Bottom Right"/>
                        <ComboBoxItem Content="Bottom Center"/>
                        <ComboBoxItem Content="Bottom Left"/>
                    </ComboBox>
                    <TextBlock x:Name="IconBarLockedText" Margin="0,8,0,0" FontSize="10" Opacity="0.8" TextWrapping="Wrap"
                               Foreground="#E5A21A" Visibility="Collapsed"
                               Text="Switch the main window's Mode to Experimental to reposition the icon bar. Normal and Advanced always keep it Top Right."/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Margin="0,16,0,0" Opacity="0.6" FontSize="11"/>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
